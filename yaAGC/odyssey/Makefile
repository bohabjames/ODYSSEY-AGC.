# ODYSSEY-AGC build.  Self-contained: it does NOT modify the upstream yaAGC
# Makefile or CMakeLists, so the normal VirtualAGC build is untouched.
#
#   make                      build build/odyssey-agc
#   make roms YAYUL=/path/to/yaYUL   assemble the AGC test ROMs
#   make test YAYUL=/path/to/yaYUL   run unit, integration and state-isolation tests
#   make asan                 same tests under AddressSanitizer + UBSan
#   make clean
#
# yaYUL is not built here.  Build it with the upstream CMake (see README.md) or
# put an existing yaYUL on PATH.
#
# The upstream engine sources (agc_engine.c, agc_engine_init.c, rfopen.c) are
# compiled with -w because they emit warnings under modern compilers.  Note that
# agc_engine.c/.h and agc_engine_init.c carry the milestone-4 state-isolation
# change; see docs/UPSTREAM-CHANGES.md.  ODYSSEY code is built with -Wall -Wextra.

CC      ?= gcc
UP      := ..
BUILD   ?= build
SAN     ?=
CFLAGS  ?= -O2 -g
ODYFLAGS := -std=gnu11 -Wall -Wextra -MMD -MP -I$(UP) -I. $(SAN)
# Optional real audio device (Linux ALSA).  Off by default; NOT built or tested in the
# development sandbox (no ALSA library there).  make ODY_WITH_ALSA=1 needs libasound2-dev.
ifeq ($(ODY_WITH_ALSA),1)
ODYFLAGS += -DODY_WITH_ALSA
AUDIO_LIBS := -lasound
endif
UPFLAGS  := -std=gnu99 -w -MMD -MP -I$(UP) $(SAN)

ODY_SRCS := odyssey_engine.c odyssey_io.c odyssey_audio.c odyssey_capture.c odyssey_scheduler.c odyssey_bus.c odyssey_rt.c odyssey_backend.c
UP_SRCS  := $(UP)/agc_engine.c $(UP)/agc_engine_init.c $(UP)/rfopen.c

ODY_OBJS := $(patsubst %.c,$(BUILD)/%.o,$(ODY_SRCS))
UP_OBJS  := $(patsubst $(UP)/%.c,$(BUILD)/up_%.o,$(UP_SRCS))

.PHONY: all roms test asan tsan clean

# Without this, the first rule pulled in from build/*.d (below) becomes the default
# goal once a build exists, and a plain `make` silently builds only that object.
.DEFAULT_GOAL := all

# Header dependencies (generated by -MMD): a changed struct layout in a header
# must rebuild every object that includes it, or objects with different layouts
# get linked together.
-include $(wildcard $(BUILD)/*.d)
all: $(BUILD)/odyssey-agc $(BUILD)/test_unit $(BUILD)/test_sched $(BUILD)/test_bus $(BUILD)/test_rt $(BUILD)/test_rt_reset $(BUILD)/test_alsa_fake

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/%.o: %.c | $(BUILD)
	$(CC) $(CFLAGS) $(ODYFLAGS) -c $< -o $@

$(BUILD)/up_%.o: $(UP)/%.c | $(BUILD)
	$(CC) $(CFLAGS) $(UPFLAGS) -c $< -o $@

$(BUILD)/odyssey_main.o: odyssey_main.c | $(BUILD)
	$(CC) $(CFLAGS) $(ODYFLAGS) -c $< -o $@

$(BUILD)/odyssey-agc: $(BUILD)/odyssey_main.o $(ODY_OBJS) $(UP_OBJS)
	$(CC) $(SAN) -o $@ $^ -lm -lpthread $(AUDIO_LIBS)

$(BUILD)/test_unit.o: tests/test_unit.c | $(BUILD)
	$(CC) $(CFLAGS) $(ODYFLAGS) -c $< -o $@

$(BUILD)/test_unit: $(BUILD)/test_unit.o $(ODY_OBJS) $(UP_OBJS)
	$(CC) $(SAN) -o $@ $^ -lm -lpthread $(AUDIO_LIBS)

$(BUILD)/test_sched.o: tests/test_sched.c | $(BUILD)
	$(CC) $(CFLAGS) $(ODYFLAGS) -c $< -o $@

$(BUILD)/test_sched: $(BUILD)/test_sched.o $(ODY_OBJS) $(UP_OBJS)
	$(CC) $(SAN) -o $@ $^ -lm -lpthread $(AUDIO_LIBS)

$(BUILD)/test_bus.o: tests/test_bus.c | $(BUILD)
	$(CC) $(CFLAGS) $(ODYFLAGS) -c $< -o $@

$(BUILD)/test_bus: $(BUILD)/test_bus.o $(ODY_OBJS) $(UP_OBJS)
	$(CC) $(SAN) -o $@ $^ -lm -lpthread $(AUDIO_LIBS)

$(BUILD)/test_rt.o: tests/test_rt.c | $(BUILD)
	$(CC) $(CFLAGS) $(ODYFLAGS) -c $< -o $@

$(BUILD)/test_rt: $(BUILD)/test_rt.o $(ODY_OBJS) $(UP_OBJS)
	$(CC) $(SAN) -o $@ $^ -lm -lpthread $(AUDIO_LIBS)

$(BUILD)/test_rt_reset.o: tests/test_rt_reset.c | $(BUILD)
	$(CC) $(CFLAGS) $(ODYFLAGS) -c $< -o $@

$(BUILD)/test_rt_reset: $(BUILD)/test_rt_reset.o $(ODY_OBJS) $(UP_OBJS)
	$(CC) $(SAN) -o $@ $^ -lm -lpthread $(AUDIO_LIBS)

# The real alsa backend code, built against the FAKE libasound in tests/fake_alsa
# (no sound hardware or ALSA library needed).
$(BUILD)/odyssey_backend_fakealsa.o: odyssey_backend.c | $(BUILD)
	$(CC) $(CFLAGS) $(ODYFLAGS) -DODY_WITH_ALSA=1 -Itests/fake_alsa -c $< -o $@

$(BUILD)/test_alsa_fake: tests/test_alsa_fake.c tests/fake_alsa/fake_alsa.c $(BUILD)/odyssey_backend_fakealsa.o \
                         $(BUILD)/odyssey_rt.o $(BUILD)/odyssey_audio.o
	$(CC) $(CFLAGS) $(ODYFLAGS) $(SAN) -Itests/fake_alsa -Itests -o $@ $^ -lm -lpthread

roms:
	YAYUL="$(YAYUL)" BUILD="$(BUILD)" tools/build_roms.sh

test: all roms
	BUILD="$(BUILD)" tests/run_tests.sh
	BUILD="$(BUILD)" SAN="$(SAN)" tests/run_isolation_tests.sh

# ThreadSanitizer for the real-time core only (needs gcc; clang here has no TSan runtime)
tsan:
	$(CC) -std=gnu11 -O1 -g -fsanitize=thread -I$(UP) -I. tests/test_rt.c odyssey_rt.c odyssey_audio.c odyssey_backend.c -o $(BUILD)/test_rt_tsan -lm -lpthread $(AUDIO_LIBS)
	$(BUILD)/test_rt_tsan
	$(CC) -std=gnu11 -O1 -g -fsanitize=thread -DODY_WITH_ALSA=1 -I$(UP) -I. -Itests/fake_alsa -Itests tests/test_alsa_fake.c tests/fake_alsa/fake_alsa.c odyssey_backend.c odyssey_rt.c odyssey_audio.c -o $(BUILD)/test_alsa_fake_tsan -lm -lpthread
	$(BUILD)/test_alsa_fake_tsan

asan:
	$(MAKE) BUILD=build-asan SAN="-fsanitize=address,undefined -fno-omit-frame-pointer" YAYUL="$(YAYUL)" test

clean:
	rm -rf build build-asan
